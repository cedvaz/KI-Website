---
import Layout from '../layouts/Layout.astro';

interface Props { title: string; description: string; children: any; }
const { title, description } = Astro.props;
---
<Layout title={`${title} | Cedric KI`} description={description} noindex={true} breadcrumbs={[{ name: 'Startseite', item: 'https://www.cedric-ki.de/' }, { name: title, item: `https://www.cedric-ki.de${Astro.url.pathname}` }]}>
  <header class="page-hero"><div class="wrap"><span class="mono-label accent">Recht · Cedric KI</span><h1 class="display">{title}</h1><p>Stand: 16. Juli 2026</p></div></header>
  <div class="wrap page-content"><div class="legal-body"><slot /></div></div>
</Layout>
