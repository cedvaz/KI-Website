const title = 'KI im Vertrieb einsetzen: Praxisbeispiele für Kempten und das Allgäu | Cedric KI';
const description = 'Wie Unternehmen in Kempten und im Allgäu KI im Vertrieb sinnvoll einsetzen: für Recherche, Gesprächsvorbereitung, Angebote und Follow-ups – mit klaren Grenzen.';
const breadcrumbs = [
  { name: 'Startseite', item: 'https://www.cedric-ki.de/' },
