---
import { Image } from 'astro:assets';
import personal from '../assets/cedric-personal-2.avif';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Über Cedric Vazquez Boo | KI-Experte im Allgäu" description="Cedric Vazquez Boo verbindet über zehn Jahre Marketing- und Vertriebserfahrung mit praktischer KI-Umsetzung für Unternehmen im Allgäu." pathname="/ueber-cedric-vazquez-boo" image="/cedric-personal-2.avif" breadcrumbs={[{ name: 'Startseite', item: 'https://www.cedric-ki.de/' }, { name: 'Über Cedric', item: 'https://www.cedric-ki.de/ueber-cedric-vazquez-boo' }]}>
  <PageHero label="Person · Cedric Vazquez Boo" title="Ich verkaufe keine KI. Ich baue Arbeitsweisen." description="Ich komme aus Marketing und Vertrieb. Deshalb starte ich nicht mit Tools, sondern mit der Arbeit, die heute noch unnötig Zeit frisst." kicker="Klartext statt Berater-Slides." />
  <section class="section"><div class="wrap case-layout"><figure class="case-image"><Image src={personal} alt="Cedric Vazquez Boo im Gespräch über KI und Marketing" width={1200} height={800} /></figure><div class="case-copy"><span class="mono-label accent">10+ Jahre Marketing & Vertrieb</span><h2 class="display display-section">Direkt mit mir.</h2><p>Workshops, Keynotes und Sparring laufen nicht über einen Apparat. Du sprichst mit der Person, die mit eurem Team arbeitet und sagt, wenn etwas Quatsch ist.</p><p>Mein Fokus: Content, Marketing, Vertrieb und die Übergabe an ein Team, das danach selbstständig weitermacht.</p></div></div></section>
  <section class="section" style="background: var(--surface-1);"><div class="wrap content-grid"><article class="content-block"><span class="mono-label accent">01</span><h2>Marketing</h2><p>Content, Kampagnen und Markenstimme, die auch mit KI erkennbar nach euch aussehen.</p></article><article class="content-block"><span class="mono-label accent">02</span><h2>Vertrieb</h2><p>Recherche, Ansprache und Follow-ups mit weniger Fleißarbeit und mehr Vorbereitung.</p></article><article class="content-block"><span class="mono-label accent">03</span><h2>Enablement</h2><p>Prompts, Templates und klare Regeln, damit ihr nach dem Workshop weitermachen könnt.</p></article><article class="content-block"><span class="mono-label accent">04</span><h2>Allgäu</h2><p>Aus Kempten für Unternehmen, die praktische KI nicht auf später verschieben wollen.</p></article></div></section>
  <section class="contact" id="contact"><div class="wrap contact-grid"><div><span class="mono-label">Kontakt</span><h2 class="display">Kurz kennenlernen?</h2><a class="contact-link" href="mailto:hi@cedric-ki.de">hi@cedric-ki.de →</a></div><p class="quiet-light">Kein Pitch. Kein Verkaufsgespräch. Einfach 15 Minuten reden.</p></div></section>
</Layout>
